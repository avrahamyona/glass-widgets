{
  "name": "glasswidgets",
  "version": "0.4.3",
  "private": true,
  "description": "Rounded-card desktop widgets for Windows",
  "main": "src/main.js",
  "scripts": {
    "prepare": "node scripts/prepare.js",
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/heebo": "^5.0.0",
    "@fontsource-variable/inter": "^5.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "app.glasswidgets",
    "files": [
      "src/**/*",
      "build/tray.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "icon": "build/icon.png",
    "nsis": {
      "artifactName": "GlassWidgets-Setup-${version}.exe",
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GlassWidgets",
      "deleteAppDataOnUninstall": false
    },
    "productName": "GlassWidgets",
    "extraResources": [
      {
        "from": "native/MediaBridge/publish",
        "to": "media",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "native/CloudBridge/publish",
        "to": "cloud",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "avrahamyona",
        "repo": "glass-widgets"
      }
    ]
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "ical.js": "^2.2.1",
    "electron-updater": "^6.3.9"
  }
}
